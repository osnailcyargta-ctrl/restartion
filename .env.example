# RESTARTION docker — copy jadi .env lalu isi (recovery code email butuh ini)
# Tanpa SMTP: recovery code tetap jalan (muncul di popup + log server, mode dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# nama pengirim yang tampil di inbox (From:). default "restartion" — biarin aja
SMTP_FROM_NAME=restartion
# starttls (default) | ssl | none
SMTP_TLS=starttls
