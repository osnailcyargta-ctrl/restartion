# .dockerignore — penting: .github_token GAK PERNAH boleh masuk image/konteks build
.github_token
.github_token.path
.env

# git + artefak lokal
.git
.gitignore
__pycache__/
*.pyc
*.pyo

# runtime data (di-mount sebagai volume /data di docker)
memory/
data_runtime/
docker-data/

# berat yang gak dipake server (server pake weights/*.pt, bukan onnx)
data/train_*.bin
data/corpus_*.txt
site/model/

# checkpoint lama — engine resolver selalu ambil part3_i8 (step 3900 = v2),
# part1/part2 (step 1450/1250) gak pernah ke-load -> 120MB dead weight di image
weights/restartion_part1_i8.pt
weights/restartion_part2_i8.pt
weights/part1.out

# gak dibutuhkan di image runtime
scripts/
docs/
screenshots/
upload/
download/
weights_backup/
templates/
static/
webui.py
*.log
